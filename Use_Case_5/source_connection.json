{
    "name": "mysql-source",
    "config": {
        "connector.class": "io.confluent.connect.jdbc.JdbcSourceConnector",
        "tasks.max": 1,
        "connection.url": "jdbc:mysql://mysql:3306/<database_name>",
        "connection.user": "<user_name>",
        "connection.password": "<user_password>",
        "mode": "timestamp+incrementing",
        "table.whitelist": "<database_name>.<source_table_name>",
        "timestamp.column.name": "<timestamp_column>",
        "incrementing.column.name": "<id_column>",     
        "error.tolerance": "all",
        "errors.log.enable": "true",
        "topic.prefix": "mysql-source-",
        "poll.interval.ms": 10
    }
}